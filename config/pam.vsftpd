# Standard behaviour for ftpd(8).
# auth	required	pam_listfile.so item=user sense=deny file=/etc/ftpusers onerr=succeed

# Note: vsftpd handles anonymous logins on its own. Do not enable pam_ftp.so.

# Standard pam includes
# @include common-account
# @include common-session
# @include common-auth
# auth	required	pam_shells.so

auth    required pam_mysql.so user=ftpuser passwd=ftpheslo host=localhost db=press table=v_vsftpd_users usercolumn=username passwdcolumn=password crypt=1 blowfish=1
account required pam_mysql.so user=ftpuser passwd=ftpheslo host=localhost db=press table=v_vsftpd_users usercolumn=username passwdcolumn=password crypt=1 blowfish=1